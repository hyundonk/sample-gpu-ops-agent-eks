        </mxCell>
        <mxCell id="tSeoul" value="서울 EKS (home)&#10;Karpenter 사다리 전체 + KEDA 가동 (max 12)&#10;Access Entry + RBAC(게이트 풀만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1145" y="248" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tTokyo" value="도쿄 EKS (warm)&#10;Karpenter 사다리 + KEDA pause(0) 어노테이션 (리전 게이트)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
