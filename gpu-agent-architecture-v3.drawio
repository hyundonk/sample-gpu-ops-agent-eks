        <mxCell id="tSns" value="SNS / 티켓 — 리포트·에스컬레이션(S13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1145" y="568" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tRevert" value="EventBridge Scheduler — 원복 타이머&#10;(원복도 동일 write Lambda·동일 경계)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1145" y="616" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tGuard" value="3중 가드레일 (write 경로)&#10;AgentCore Policy → Lambda 코드 재검증 →&#10;K8s RBAC resourceNames (상시 사다리 불가침)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1145" y="680" width="300" height="64" as="geometry" />
