        </mxCell>
        <mxCell id="tMumbai" value="뭄바이 EKS (warm)&#10;Karpenter 사다리 + KEDA pause(0) 어노테이션 (리전 게이트)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1145" y="374" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tValkey" value="중앙 ElastiCache Valkey 큐 (서비스 플랫폼)&#10;— 3리전 KEDA가 공동 소비 (라우팅 계층 없음)&#10;큐 깊이 → CloudWatch exporter (알람 전제)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1145" y="440" width="300" height="64" as="geometry" />
